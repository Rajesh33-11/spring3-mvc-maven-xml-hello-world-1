pipeline {
    agent any

    parameters {
        gitParameter name: 'BRANCH', type: 'PT_BRANCH',
                     branchFilter: 'origin/(.*)', defaultValue: 'master',
                     selectedValue: 'DEFAULT', sortMode: 'ASCENDING_SMART',
                     description: 'Branch to build'
        choice(name: 'MAVEN_GOAL', choices: ['clean package', 'clean install', 'clean verify'],
               description: 'Maven goal to run')
        string(name: 'JDK_VERSION', defaultValue: '1.8',
               description: 'Compiler level (pom default 1.6 is too old for JDK 17)')
        booleanParam(name: 'mvn_build', defaultValue: true, description: 'Run the Maven build?')
        booleanParam(name: 'publish_to_nexus', defaultValue: false,
                     description: 'Upload the WAR to Nexus?')
    }

    tools { maven 'MVN_HOME' }

    environment {
        NEXUS_URL           = 'nexus:8081'
        NEXUS_REPOSITORY    = 'ncodeit-helloworld'
        NEXUS_CREDENTIAL_ID = 'nexus_credentials'
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: "${params.BRANCH}",
                    url: 'https://github.com/betawins/spring3-mvc-maven-xml-hello-world-1.git'
            }
        }

        stage('Maven Build') {
            when { expression { return params.mvn_build } }
            steps {
                sh "mvn -B -Djdk.version=${params.JDK_VERSION} ${params.MAVEN_GOAL}"
            }
        }

        stage('Publish to Nexus') {
            when { expression { return params.publish_to_nexus } }
            steps {
                script {
                    def pom = readMavenPom file: 'pom.xml'
                    def war = findFiles(glob: 'target/*.war')[0].path
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3', protocol: 'http',
                        nexusUrl: env.NEXUS_URL, groupId: pom.groupId,
                        version: "${env.BUILD_NUMBER}",
                        repository: env.NEXUS_REPOSITORY,
                        credentialsId: env.NEXUS_CREDENTIAL_ID,
                        artifacts: [[artifactId: pom.artifactId, classifier: '',
                                     file: war, type: 'war']]
                    )
                }
            }
        }
    }

    post {
        always {
            echo "Branch: ${params.BRANCH}, build: ${params.mvn_build}, " +
                 "nexus: ${params.publish_to_nexus}"
        }
    }
}
